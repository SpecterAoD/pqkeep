{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "policies": [
    {
      "action": "tool.use",
      "resource": "shell:*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "external_directory:*",
      "effect": "deny"
    }
  ]
}
